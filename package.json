{
  "name": "csrinru-steam-hover-preview",
  "version": "4.0.8",
  "private": true,
  "type": "module",
  "description": "Standalone Steam hover userscript and canonical shared core",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "node scripts/check.mjs",
    "sync-core": "node scripts/sync-core.mjs",
    "lint": "eslint src scripts tests",
    "format": "prettier --write src scripts tests *.mjs *.json .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.mjs *.json .github/workflows/*.yml",
    "vendor:fuse": "node scripts/vendor-fuse.mjs"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "fuse.js": "7.5.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
